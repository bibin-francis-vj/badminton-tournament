# Supabase Configuration  (see docs/SETUP.md)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Authentication
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_password

# Reset Password
# Required for the dashboard "Reset" options: "Reset scores only" or "Reset everything" (deletes all data)
VITE_RESET_PASSWORD=your_reset_password
